{
  "name": "ClothingItem",
  "type": "object",
  "title": "ClothingItem",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "top",
        "bottom",
        "onesie",
        "outerwear",
        "dress",
        "set",
        "other"
      ]
    },
    "icon": {
      "type": "string"
    },
    "size": {
      "type": "string",
      "enum": [
        "0-3M",
        "3-6M",
        "6-9M",
        "9-12M",
        "12-18M",
        "18-24M",
        "2T",
        "3T",
        "4T"
      ]
    },
    "originalPriceCents": {
      "type": "integer",
      "minimum": 0
    },
    "originalPurchaseDate": {
      "type": "string",
      "format": "date-time"
    },
    "ownerCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "currentOwnerId": {
      "type": "string"
    },
    "childId": {
      "type": "string"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ownershipHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ownerId": {
            "type": "string"
          },
          "from": {
            "type": "string",
            "format": "date-time"
          },
          "to": {
            "type": "string",
            "format": "date-time"
          },
          "priceCents": {
            "type": "integer"
          }
        }
      }
    },
    "predictedOutgrowDate": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "in_closet",
        "listed",
        "pending_trade",
        "transferred_out"
      ]
    }
  },
  "required": [
    "name",
    "size",
    "originalPriceCents",
    "ownerCount",
    "currentOwnerId",
    "status"
  ],
  "rls": {
    "create": false,
    "read": true,
    "update": false,
    "delete": false
  }
}
