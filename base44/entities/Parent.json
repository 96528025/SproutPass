    "photonUserId": {
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "photonSpaceId": {
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "photonLineUserId": {
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "convo": {
      "type": "object",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "asiAddress": {
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "mandate": {
      "type": "object",
      "description": "What this parent's pet agent may do on their behalf (trusted checkout). Server-only; read through getTrust.",
      "properties": {
        "maxPriceCents": {
          "type": "integer"
        },
        "monthlyBudgetCents": {
          "type": "integer"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requirePasskey": {
          "type": "boolean"
        },
        "agentMayPropose": {
          "type": "boolean"
        }
      },
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "passkeys": {
      "type": "array",
      "description": "WebAuthn credentials that approve payments (credential id, public key, counter, transports, label). Server-only.",
      "items": {
        "type": "object"
      },
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "passkeyChallenge": {
      "type": "object",
      "description": "The one live single-use WebAuthn challenge (5 min). Server-only.",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "key",
    "name"
  ],
  "rls": {
    "create": false,
    "read": true,
    "update": false,
    "delete": false
