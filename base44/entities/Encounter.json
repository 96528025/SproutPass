{
  "name": "Encounter",
  "type": "object",
  "title": "Encounter",
  "properties": {
    "aId": {
      "type": "string"
    },
    "bId": {
      "type": "string"
    },
    "band": {
      "type": "string"
    },
    "simulated": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "talking",
        "proposed",
        "no_match"
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "proposalId": {
      "type": "string"
    },
    "rearmedAt": {
      "type": "string",
      "format": "date-time"
    },
    "hasMatch": {
      "type": "boolean",
      "description": "Set when the meeting starts: a shared active listing of one parent fits a shared need of the other, either way (before the buyer's pet rules). false = nothing fits, the app does not pop the meeting"
    },
    "negotiatedBy": {
      "type": "string",
      "enum": [
        "fetch",
        "local"
      ]
    },
    "noMatchReason": {
      "type": "string",
      "description": "Why a no_match encounter ended without a trade when the buyer's pet rules said no (one plain sentence, no amounts)"
    },
    "agentLog": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "ms": {
            "type": "number"
          },
          "by": {
            "type": "string",
            "enum": [
              "fetch",
              "fallback",
              "mock"
            ]
          }
        }
      }
    },
    "transcript": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "enum": [
              "buyer_agent",
              "seller_agent"
            ]
          },
          "parentId": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "looking_for",
              "have",
              "no_fit",
              "fit_check",
              "propose",
              "ack",
              "decline"
            ]
          },
          "text": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "required": [
    "aId",
    "bId",
    "status"
  ],
  "rls": {
    "create": false,
    "read": true,
    "update": false,
    "delete": false
  }
}
