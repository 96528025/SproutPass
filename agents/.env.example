# copy to agents/.env  (never commit .env)
BASE44_URL=https://<slug>.base44.app
AGENT_KEY=<same value as the Base44 secret AGENT_KEY>
TEAM_SECRET=<any shared string; it fixes the agent addresses>
APP_URL=https://<slug>.base44.app
# optional: skip the lookupParent call
# PARENT_ID_MINA=...  PARENT_ID_JO=...  PARENT_ID_SAM=...
# ASI_OPEN=1  (default) lets any ASI:One user chat without "claim"; set 0 to require claim
