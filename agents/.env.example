# copy to agents/.env  (never commit .env). live_bureau.py also reads AGENT_KEY from ../.env.local.
BASE44_URL=https://sproutpass-5c025059.base44.app
AGENT_KEY=<same value as the Base44 secret AGENT_KEY>
TEAM_SECRET=<any shared string; it fixes the agent addresses (default "dev")>
APP_URL=https://sproutpass-5c025059.base44.app
# rate limit: the Base44 Free plan gives the whole team ~10 function calls/min
# CALLS_PER_MIN=8   POLL_S=12   FAST_POLL_S=4   APPEND_TURNS=0   SEND_LINES=1
# optional: skip the lookupParent calls
# PARENT_ID_MINA=...  PARENT_ID_JO=...  PARENT_ID_SAM=...
# ASI_OPEN=0  (default) an ASI:One user must "claim mina-<code>" before the agent answers or forwards anything.
#             1 = an unclaimed user may also say hi / help / bag (shows the bag to anyone!); sell, keep, accept,
#             decline and pay always need the claim, and only the claimed user gets the parent's later lines.
# INBOX_MAX_AGE_S=600  inbox rows older than this (a backlog from while the agents were off) are completed silently
